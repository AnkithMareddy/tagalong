{
  "name": "tagalong",
  "version": "1.0.0",
  "private": true,
  "description": "A travel agent that lives in your group chat: turns your saved places into an itinerary, then follows the trip with live transit, nearby picks and reminders.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --env-file=.env src/index.js",
    "simulate": "node scripts/simulate.js",
    "simulate:live": "node --env-file=.env scripts/simulate.js --live",
    "check-data": "node scripts/check-data.js",
    "test": "node --test test/*.test.js",
    "setup": "node scripts/setup.js",
    "import": "node scripts/import-places.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0"
  }
}
